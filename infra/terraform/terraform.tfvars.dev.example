environment                   = "dev"
aws_region                    = "us-east-1"
arcgis_runtime_secret_arn     = "arn:aws:secretsmanager:us-east-1:123456789012:secret:/sitrep-int/dev/arcgis/runtime"
everbridge_polling_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:/sitrep-int/dev/everbridge/polling"
everbridge_draft_secret_arn   = "arn:aws:secretsmanager:us-east-1:123456789012:secret:/sitrep-int/dev/everbridge/draft"
arcgis_webhook_secret_arn     = "arn:aws:secretsmanager:us-east-1:123456789012:secret:/sitrep-int/dev/webhooks/arcgis"
everbridge_webhook_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:/sitrep-int/dev/webhooks/everbridge"
alarm_notification_topic_arns = ["arn:aws:sns:us-east-1:123456789012:sitrep-int-dev-ops"]
operational_alarm_overrides = {
  hazard_duplicate_suppression = {
    enabled = false
  }
  hazard_missing_event_correlation = {
    threshold = 2
    period    = 900
  }
}