environment                   = "prod"
aws_region                    = "us-east-1"
arcgis_runtime_secret_arn     = "arn:aws:secretsmanager:us-east-1:123456789012:secret:/sitrep-int/prod/arcgis/runtime"
everbridge_polling_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:/sitrep-int/prod/everbridge/polling"
everbridge_draft_secret_arn   = "arn:aws:secretsmanager:us-east-1:123456789012:secret:/sitrep-int/prod/everbridge/draft"
arcgis_webhook_secret_arn     = "arn:aws:secretsmanager:us-east-1:123456789012:secret:/sitrep-int/prod/webhooks/arcgis"
everbridge_webhook_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:/sitrep-int/prod/webhooks/everbridge"
alarm_notification_topic_arns = ["arn:aws:sns:us-east-1:123456789012:sitrep-int-prod-ops"]
operational_alarm_overrides = {
  hazard_duplicate_suppression = {
    threshold = 3
  }
  everbridge_poll_duplicate_suppression = {
    threshold = 2
  }
}